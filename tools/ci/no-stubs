#!/usr/bin/env python3
"""no-stubs: fail when shipped source contains stubs, placeholders, mock or sample data, or dead click handlers.
Scans shipped source folders only; tests, fixtures, stories and mocks folders are allowed.
A line may opt out only when it names a default-off feature flag: `no-stubs: flag=<name>`.
Usage: python3 tools/ci/no-stubs [repo_root]   (exit 0 = clean, 1 = findings)"""
import re, sys
from pathlib import Path
ROOT = Path(sys.argv[1] if len(sys.argv) > 1 else ".").resolve()
SHIPPED = ["src", "app", "lib", "components", "pages", "server", "api"]
EXTS = {".js", ".jsx", ".ts", ".tsx", ".py", ".swift", ".kt", ".dart", ".vue", ".svelte", ".html"}
SKIP_PARTS = {"test", "tests", "__tests__", "fixtures", "__fixtures__", "mocks", "__mocks__", "stories", "node_modules", "dist", "build"}
WORDS = re.compile(r"\b(TODO|FIXME|placeholder|lorem ipsum|lorem|coming soon|not implemented|NotImplementedError|mock[A-Za-z_]*|stub[A-Za-z_]*|sample[_-]?data|fake[_-]?data)\b", re.I)
SAMPLE_IMPORT = re.compile(r"(import|require|from)\s*[(\s]*['\"][^'\"]*(sample|mock|fixture|fake)[^'\"]*['\"]", re.I)
DEAD_HANDLER = re.compile(r"on[A-Z][A-Za-z]*\s*=\s*\{\s*\(\s*\)\s*=>\s*(\{\s*\}|\{\s*console\.log\([^)]*\);?\s*\}|console\.log\([^)]*\)|undefined|null)\s*\}")
FLAG = re.compile(r"no-stubs:\s*flag=[A-Za-z0-9_.-]+")
def shipped_files():
    for top in SHIPPED:
        base = ROOT / top
        if not base.is_dir():
            continue
        for f in base.rglob("*"):
            rel = f.relative_to(ROOT)
            if f.is_file() and f.suffix in EXTS and not (set(p.lower() for p in rel.parts) & SKIP_PARTS) and not re.search(r"\.(test|spec|stories)\.", f.name):
                yield f, rel
findings = []
for f, rel in shipped_files():
    for n, line in enumerate(f.read_text(encoding="utf-8", errors="ignore").splitlines(), 1):
        if FLAG.search(line):
            continue
        for rx, kind in ((WORDS, "stub/placeholder word"), (SAMPLE_IMPORT, "sample/mock import"), (DEAD_HANDLER, "dead click handler")):
            m = rx.search(line)
            if m:
                findings.append(f"{rel}:{n}: {kind}: {m.group(0)[:60]}")
for x in findings:
    print("NO-STUBS", x)
print("no-stubs: clean" if not findings else f"no-stubs: {len(findings)} finding(s). Make it real, cut scope, or put it behind a default-off flag and log it in docs/BUILD-STATE.md.")
sys.exit(1 if findings else 0)
