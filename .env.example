# Purpose: Lists every environment variable this site expects.
# Copy to .env.local and fill in real values. Never commit .env.local.

# --- Supabase (public site + admin + chatbot backend) ---
# Project URL from the Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=
# Anon/public key safe for the browser (RLS still applies)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key for server-only routes. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI chatbot (server routes only) ---
# Provider API key used by lib/ai for retrieval-augmented answers
AI_API_KEY=
# Optional model id override once a provider is chosen
AI_MODEL=

# --- Analytics (optional until wired) ---
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
NEXT_PUBLIC_PIXEL_ID=

# --- Integrations (optional until wired) ---
GITHUB_TOKEN=
CRM_WEBHOOK_URL=
USPOT_WEBHOOK_URL=

# --- Bridger shared tastes (powers the home page "Now" section) ---
# Base URL of the Bridger API. Leave blank to show the Now placeholder.
BRIDGER_API_BASE=
# The public share slug for Brant's interests. Leave blank to show the placeholder.
BRIDGER_SHARE_SLUG=
# Optional server-only token if the share endpoint needs one.
# Never rename this to NEXT_PUBLIC_ anything: it must stay off the browser.
BRIDGER_SHARE_TOKEN=

# --- Admin auth (single-user portal) ---
ADMIN_PASSWORD_HASH=
JWT_SECRET=
