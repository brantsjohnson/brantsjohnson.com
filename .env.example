# Purpose: Lists every environment variable this site expects.
# Copy to .env.local and fill in real values. Never commit .env.local.

# --- Supabase (public site + admin + chatbot backend) ---
# Project URL from the Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=
# Anon/public key safe for the browser (RLS still applies)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key for server-only routes. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI chatbot (server routes only) ---
# REQUIRED for /chat to work. OpenAI key used by app/api/chatbot.
# It must belong to the account that owns Brant's fine-tuned model below.
OPENAI_API_KEY=
# Optional. Which model the chatbot uses. Defaults to Brant's fine-tuned
# model. Set this to a base model (e.g. gpt-4o-mini) if the key above does
# not have access to the fine-tune.
AI_MODEL=

# --- Analytics (optional until wired) ---
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
NEXT_PUBLIC_PIXEL_ID=

# --- Integrations (optional until wired) ---
GITHUB_TOKEN=
CRM_WEBHOOK_URL=
# Intro CRM capture for the /hi form. Notes post here only when BOTH this URL
# and INTRO_CRM_CAPTURE_SECRET are set. Otherwise the form opens the visitor's email app.
INTRO_CRM_CAPTURE_URL=
# Shared secret sent as the x-intro-capture-secret header. Required with the URL above.
INTRO_CRM_CAPTURE_SECRET=

# Set to true only at DNS cutover, when this site should be indexed.
# Leave unset on previews so they do not compete with the live Wix site.
SITE_INDEXABLE=
USPOT_WEBHOOK_URL=

# Public site URL used for the BrantChat subdomain redirect and the /hi QR code.
NEXT_PUBLIC_SITE_URL=https://www.brantsjohnson.com

# Public CV link. Experience shows "Open the CV" only when this is a real URL.
# Leave it blank to hide that button. Do not put a private file link here.
CV_URL=

# Substack publication root, such as https://example.substack.com
# When set, Writing reads {url}/feed and the signup link is {url}/subscribe.
# When unset, the signup stays hidden. Writing stays hidden until a real post exists.
SUBSTACK_URL=

# Monthly dollar cap for the AI chat in one server process. Default is 5.
CHAT_MONTHLY_USD=5

# --- Bridger shared tastes (powers the home page "Now" section) ---
# Base URL of the production Bridger API.
BRIDGER_API_BASE=https://jiyzei8qqu.us-east-1.awsapprunner.com
# Required later: the public share slug for Brant's interests. Left blank on
# purpose. Brant pastes it here after he enables sharing in Bridger. Until then
# the live fetch stays off and the Now section shows its placeholder.
BRIDGER_SHARE_SLUG=
# Optional server-only token if the share endpoint needs one.
# Never rename this to NEXT_PUBLIC_ anything: it must stay off the browser.
BRIDGER_SHARE_TOKEN=

# --- Admin auth (single-user portal) ---
ADMIN_PASSWORD_HASH=
JWT_SECRET=

# --- BrantChat subdomain deployment (brantchat.brantsjohnson.com) ---
# These belong to the separate BrantChat/ app, which stays live as its own
# Vercel deployment. The apex site (/chat) does NOT need them; they are
# listed here so CoS has all env var NAMES in one place. Values live only in
# that project's Vercel settings, never in git.
# OpenAI key for the subdomain app (same purpose as OPENAI_API_KEY above)
# OPENAI_API_KEY=
# Secret used to sign the subdomain app's access tokens (JWT)
# JWT_SECRET=
# Supabase for the subdomain app's chat logging and job questions
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# Optional KV store so the subdomain app persists admin-edited job roles
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
