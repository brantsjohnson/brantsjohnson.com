# Purpose: Lists every environment variable this site expects.
# Copy to .env.local and fill in real values. Never commit .env.local.

# --- Supabase (public site + admin + chatbot backend) ---
# Project URL from the Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=
# Anon/public key safe for the browser (RLS still applies)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key for server-only routes. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI chatbot (server routes only) ---
# REQUIRED for /chat to work. OpenAI key used by app/api/chatbot.
# It must belong to the account that owns Brant's fine-tuned model below.
OPENAI_API_KEY=
# Optional. Which model the chatbot uses. Defaults to Brant's fine-tuned
# model. Set this to a base model (e.g. gpt-4o-mini) if the key above does
# not have access to the fine-tune.
AI_MODEL=

# --- Analytics (optional until wired) ---
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
NEXT_PUBLIC_PIXEL_ID=

# --- Integrations (optional until wired) ---
GITHUB_TOKEN=
CRM_WEBHOOK_URL=
USPOT_WEBHOOK_URL=

# --- Admin auth (single-user portal) ---
ADMIN_PASSWORD_HASH=
JWT_SECRET=
