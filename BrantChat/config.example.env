# OpenAI API Key - Get this from https://platform.openai.com/api-keys
# Purpose: Placeholder only. Put your real key in .env.local (never commit it).
OPENAI_API_KEY=sk-proj-your_openai_api_key_here

# JWT Secret - Generate a secure random string for production
JWT_SECRET=your_super_secure_jwt_secret_here

# Company Access Codes - Each company gets its own access code
# Default access codes (CHANGE THESE!):
# Google: "google123"
# Microsoft: "microsoft123" 
# Apple: "apple123"
# Admin: "password"

# You can add more companies by editing the COMPANY_PASSWORDS object in app/api/auth/route.ts

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
